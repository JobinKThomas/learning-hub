PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# MONGODB CONFIGURATION (MongoDB Atlas / Local)
# ------------------------------------------------------------------------------
# In MongoDB Atlas, you use a single cluster with separate database names:
#
# Atlas Connection String Format:
# mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/<database_name>?retryWrites=true&w=majority
#
# 1) Development Database (e.g. learning_hub_dev):
# MONGODB_URI_DEV=mongodb+srv://dbUser:yourPassword@cluster0.abcde.mongodb.net/learning_hub_dev?retryWrites=true&w=majority
#
# 2) Production Database (e.g. learning_hub_prod):
# MONGODB_URI_PROD=mongodb+srv://dbUser:yourPassword@cluster0.abcde.mongodb.net/learning_hub_prod?retryWrites=true&w=majority
#
# 3) Fallback / Default Database URI (Used if specific DEV/PROD URI is not set):
MONGODB_URI=mongodb://127.0.0.1:27017/learning_hub

# ------------------------------------------------------------------------------
# JWT & SECURITY
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=super_secret_jwt_access_key_learning_hub_2026
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_learning_hub_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
ADMIN_REGISTRATION_KEY=admin123
